# Скопируйте в .env и заполните значения.
# Файл .env не коммитится в репозиторий.

# mock | openai | anthropic
LLM_PROVIDER=mock

# Ключ нужен только для реальных провайдеров (openai/anthropic)
LLM_API_KEY=

LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=3

CACHE_TTL_SECONDS=600
LOG_LEVEL=INFO
